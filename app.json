{
  "expo": {
    "name": "SiapSiaga",
    "slug": "siapsiaga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F4C81"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.siapsiaga.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SiapSiaga memerlukan lokasi Anda untuk mengirim laporan darurat ke petugas ronda/satpam."
      }
    },
    "android": {
      "package": "com.siapsiaga.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F4C81"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SiapSiaga memerlukan lokasi Anda untuk mengirim laporan darurat ke petugas ronda/satpam."
        }
      ],
      "expo-notifications",
      "./plugins/withCleartextTraffic"
    ],
    "extra": {
      "eas": {
        "projectId": "a59fbde2-e62e-4f0a-a430-9422dd619ff8"
      }
    }
  }
}
