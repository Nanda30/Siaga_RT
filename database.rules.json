{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },

    "alerts": {
      ".read": "auth != null",
      ".indexOn": "createdAt",
      "$alertId": {
        ".write": "auth != null"
      }
    }
  }
}
